# Copy to .env and fill in. Never commit .env.

# Google Earth Engine (Cloud project ID you registered for noncommercial use)
EE_PROJECT=

# Copernicus Data Space credentials
CDSE_USERNAME=
CDSE_PASSWORD=

# Postgres (experiment and evaluation results; read by Grafana)
POSTGRES_USER=lankaflood
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lankaflood
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
